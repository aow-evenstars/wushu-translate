tips_xjz_lybs_003_0=Talk to the Escort after combat and pacify him
tips_xjz_lybs_004_0=Kill all bandits
tips_xjz_lybs_005_0=Use the third skill in the tool box to extinguish fire
tips_xjz_lybs_006_0=Kill bandit leader to get reward, <font color="#ff6600">do not leave the scene before getting the mail</font>
