tips_rp_arm_str=Brawn : {@0:Str+StrAdd}({@1:Str}+{@2:StrAdd})<br>Increases HP: {@3:maxhp}<br>Striking Power Increases: {@4:meleepower}<br>Internal Skill Power Increases: {@5:magicpower}<br>External Attack Accuracy Increases: {@6:phyhit}<br>External Skill Critical Hit Increases: {@7:PhyVa}<br>Parry Increases: {@8:PhyParry}
tips_rp_arm_dex=Agility {@0:Dex+DexAdd}({@1:Dex}+{@2:DexAdd})<br>Hidden Weapon Damage Increases By {@3:shotpower}<br>External Skill Accuracy increases by {@4:shotpower}<br>Evade increases by{@5:Evade}<br>External Skill Critical Hit increases by {@6:phyva}<br>Parry value increases by {@7:phyparry}
tips_rp_arm_ing=Intelligence {@0:Ing+IngAdd}({@1:Ing}+{@2:IngAdd})<br>Energy value increases by {@3:maxmp}<br>Internal Attack Damage increases by {@4:magicpower}<br>Internal Attack Accuracy increases by {@5:magichit}<br>Internal Attack Critical Hit Rate increases by {@6:magicva}<br>Defusion value increases by {@7:magicparry}<br>Healing level increases by {@8:healpower}
tips_rp_arm_spi=Spirit: {@0:Spi+SpiAdd} ({@1:Spi}+{@2:SpiAdd})<br>Energy: Increases: {@3:maxmp}<br>Energy Automatic Recovery Increases: {@4:mpupspeed}<br>Internal Attack Accuracy Increases: {@5:magichit}<br>Internal Attack Critical Hit Increases: {@6:magicva}<br>Parry Increases: {@7:magicparry}<br>Healing Level Increases: {@8:healpower}
tips_rp_arm_sta=Constitution: {@0:Sta+StaAdd} ({@1:Sta}+{@2:StaAdd})<br>Max HP Increases by {@3:maxhp}.<br>HP Automatic Recovery Increases by {@4:hpupspeed}.<br>Resilience increases by {@5:vadef}.
tips_rp_arm_phydef=Defense {@0:PhyDef+PhyDefAdd}<br>Reduces Melee Damage by {@1:PhyRes}%
tips_rp_arm_phyhit=Accuracy {@0:phyhit}<br>Increases Melee Attack Accuracy when attacking same level targets by {@1:phyhitprob}%
tips_rp_arm_phyva=Critical Hit {@0:phyva}<br>Critical Hit Rate {@1:phyvaprob}%<br>Critical Hit Multiplier {@2:phyvadamage}%
tips_rp_arm_magicdef=Internal Skill Defense {@0:minmagicdef}<br>Cancels {@1:minmagicres}% of the damage from enemy's Internal Attack Damages.<br>When the corresponding attribute defense is lower than Internal Skill Defense, the system will calculate with the value.
tips_rp_arm_magichit=Accuracy {@0:magichit}<br>Increases your Internal Attack Damage accuracy on a level {@1:Level} target by {@2:magichitprob}%
tips_rp_arm_magicva=Critical Hit {@0:magicva}<br>Critical Hit Rate {@1:magicvaprob}%<br>Critical Hit Multiplier {@2:magicvadamage}%
tips_rp_arm_melee_damage=Melee Weapon<br>Attack Speed: {@0:attacktime} seconds<br>Damage: {@1:最小伤害} - {@2:最大伤害}<br>Damage Per Second: {@3:平均每秒伤害}
tips_rp_arm_melee_attacktime=Attack Speed {@0:近身武器的attacktime}<br>Acceleration Level {@1:attackspeed} ( {@2:-AttackHaste*100}% Accelerate )
tips_rp_arm_melee_power=Melee Damage: {@0:meleepower}<br>Increases melee weapon damage by {@1:(MeleePowerProb+MeleePowerProbAdd-1)*100}%.
tips_rp_arm_shot_damage=Hidden Weapon<br>Attack Speed (seconds) {@0:Hidden Weapon 的AttackTime}<br>Damage {@1:最小Damage }-{@2:最大Damage }<br>Damage per second: {@3:平均每秒Damage }
tips_rp_arm_shot_attacktime=Attack Speed {@0:暗器的AttackTime}<br>Acceleration Level {@1:attackspeed}({@2:-AttackHaste*100}% Accelerate)
tips_rp_arm_shot_power=Hidden Weapon Damage: {@0:shotpower}<br>Increases Hidden Weapon Damage: {@1:(shotpowerprob)*100}%
tips_rp_arm_magic_power=Internal Attack Damage {@0:magicpower}<br>Increases Internal Attack Damage by {@1:(magicpowerprob)*100}%
tips_rp_arm_attackspeed=Accelerate Level {@0:attackspeed}<br>Increase Chi gathering speed by {@1:-AttackHaste*100}%
tips_rp_arm_healpower=Healing Level {@0:healpower}<br>Increase your Healing Effect by {@0:healpowerprob}%
tips_rp_arm_mpupspeed=Recover Energy {@0:mpupspeed}<br>Recover {@2:mpupspeed} Energy every 5 seconds.
tips_rp_arm_phyparry=Parry: {@0:phyparry}<br>Parry Rate: {@1:phyparryprob}%
tips_rp_arm_magicparry=Defuse {@0:magicparry}<br>Defusion Rate {@1:magicparryprob}%
tips_rp_arm_dodge=Evade {@0:Evade}<br>Evade {@1:Evadeprob}%
tips_rp_arm_vadef=Resilience: {@0:vadef}<br>Decreases Critical Hit Rate by {@1:vadefprob}%.<br>Decreases Critical Hit damage by {@2:vadamagedef}%.
