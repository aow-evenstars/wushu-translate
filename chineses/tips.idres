tips_itemtype_220=Guild Item
tips_stall_buyprice_0=Purchase Price: <img src="gui\common\money\jyb.png" valign="center" /> {@0:锭两文}
tips_stall_buyprice_1=Purchase Price: <img src="gui\common\money\yyb.png" valign="center" /> {@0:锭两文}
