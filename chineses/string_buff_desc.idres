desc_buff_beiyuan_wy_001_0=Lady Qiu interrupts your conversation with Qiu Qingyuan. She has something to say to you.
desc_buff_beiyuan_wy_001_1=
desc_buff_beiyuan_wy_002_1=
desc_buff_beiyuan_wy_003_0=What Lady Qiu said appears to be true. To be sure, confirm with Nan Yiwei.
desc_buff_beiyuan_wy_003_1=
