desc_buff_beiyuan_wy_006_1=
desc_buff_beiyuan_wy_007_0=Aside from pleasing this masochist, whipping Nan Yiwei is getting you nowhere. Go talk to Zhou Cong.
desc_buff_beiyuan_wy_007_1=
