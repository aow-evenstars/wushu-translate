desc_buf_ng_gm_002_0=<font color="#f9fc00">Icy Jade Secret</font>
desc_buf_ng_gm_002_01_0=<font color="#f9fc00">Piercing Icy Coldness</font>
desc_buf_ng_gm_002_01_1=<font color="#FF3030">Piercing Icy Coldness</font><br>Movement Speed decreases by 20%. When hit, takes an additional 10% Yin Damage.
desc_buf_ng_gm_002_01_2=<font color="#FF3030">Piercing Icy Coldness</font><br>Movement Speed decreases by 25%. When hit, takes an additional 12% Yin Damage.
desc_buf_ng_gm_002_01_3=<font color="#FF3030">Piercing Icy Coldness</font><br>Movement Speed decreases by 30%. When hit, takes an additional 14% Yin Damage.
desc_buf_ng_gm_002_01_4=<font color="#FF3030">Piercing Icy Coldness</font><br>Movement Speed decreases by 40%. When hit, takes an additional 17% Yin Damage.
desc_buf_ng_gm_002_01_5=<font color="#FF3030">Piercing Icy Coldness</font><br>Movement Speed decreases by 50%. When hit, takes an additional 20% Yin Damage.
