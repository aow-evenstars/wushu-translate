desc_buff_bossadv009001_jz_1=
desc_buff_bossadv009001_ky_0=Ma Xingxing is naturally endowed with Mind’s Focus on Three Flowers and has a constitution quite different from other people’s. He will become so unnaturally strong after 6 minutes of fighting that if you touch him, you will die immediately.
desc_buff_bossadv009001_ky_1=
