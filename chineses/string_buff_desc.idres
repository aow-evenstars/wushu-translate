desc_buff_newworld_jwd_001_1=
desc_buff_newworld_jwd_002_0=An unidentified poison effect.
desc_buff_newworld_jwd_002_1=
desc_buff_newworld_jwd_003_0=Sky Centipede Poison: Movement slowed when poisoned. Gods Will Pill will remove and create temporary immunity to this effect.
desc_buff_newworld_jwd_003_1=
desc_buff_newworld_jwd_004_0=Poison of Locusts: Causes dizziness and randomized keystrokes. Gods Will Pill will remove and create temporary immunity to this effect.
desc_buff_newworld_jwd_004_1=
desc_buff_newworld_jwd_005_0=Virulent Insects Attack: Causes continuous loss of HP and energy. Gods Will Pill will remove and create temporary immunity to this effect.
desc_buff_newworld_jwd_005_1=
desc_buff_newworld_jwd_006_0=Gods Will Pill effect: Neutralizes Sky Centipede Poison, Poison of Locusts and Virulent Insects Attack, and creates immunity to them for a certain period of time.
desc_buff_newworld_jwd_006_1=
desc_buff_newworld_jwd_007_0=Youming Poison: Created by Bai Feifei of Youming Palace. When attacked, gets a chance of knocking attacker down and making him bleed overtime. Gods Will Pill is unable to remove or create immunity to this effect.
desc_buff_newworld_jwd_007_1=
desc_buff_newworld_jwd_008_0=Youming Poison: Created by Bai Feifei of Youming Palace. When attacked, continuously loses HP and flying skill points.
desc_buff_newworld_jwd_008_1=
desc_buff_newworld_jwd_009_0=When target has Break Defense buff, Frail effect will be cast added to the target when he is attacked. Once it reaches a certain level, it will remove the Super Armor effect. This buff ends when Yu Dandan is dead.
desc_buff_newworld_jwd_009_1=
desc_buff_newworld_jwd_010_0=Recover 30% of the max HP every once in a while. Buff ends when Ye Dachun is dead.
desc_buff_newworld_jwd_010_1=
desc_buff_newworld_jwd_011_0=Recover 30% of the max energy every once in a while. Buff ends when Xue Ganggang is dead.
desc_buff_newworld_jwd_011_1=
desc_buff_newworld_jwd_012_0=Will of the Gods effect neutralizes Sky Centipede Poison, Poison of Locusts and Virulent Insects Attack every once in a while. Buff ends when Yao Sanzhi is dead.
desc_buff_newworld_jwd_012_1=
