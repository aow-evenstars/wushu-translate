buf_schoolwar_zzcc_1=Strength of Unity
desc_buf_schoolwar_zzcc_1_0=<font color=\"#FF7F00\">Trick the Enemy</font><br>Increase Brawn by 50, and recover 50 HP every 5 seconds. <br><font color=\"#FF7F00\">Strength of Unity</font><br>Increase the upper limit of HP by 500, and decrease the damage by 10%.
buf_schoolwar_zzcc_2=Strength of Unity
desc_buf_schoolwar_zzcc_2_0=<font color=\"#FF7F00\">Trick the Enemy</font><br>Increase Brawn by 50, and recover 50 HP every 5 seconds. <br><font color=\"#FF7F00\">Strength of Unity</font><br>Increase the upper limit of HP by 500, and decrease the damage by 10%.
buf_schoolwar_zzcc_3=Strength of Unity
desc_buf_schoolwar_zzcc_3_0=<font color=\"#FF7F00\">Trick the Enemy</font><br>Increase Brawn by 50, and recover 50 HP every 5 seconds. <br><font color=\"#FF7F00\">Getting a new lease on life</font><br>balance is increased by 50, and 10 Internal Energy is recovered each 5 seconds. <br><font color=\"#FF7F00\">Strength of Unity</font><br>The player increases the upper limit of HP to 1000, and damage is increased by 15%.
buf_schoolwar_zzcc_4=Strength of Unity
desc_buf_schoolwar_zzcc_4_0=<font color=\"#FF7F00\">Trick the Enemy</font><br>Increase Brawn by 50, and recover 50 HP every 5 seconds. <br><font color=\"#FF7F00\">Getting a new lease on life</font><br>balance is increased by 50, and 10 Internal Energy is recovered each 5 seconds. <br><font color=\"#FF7F00\">Clear Autumn Water</font><br>Breath is increased by 50, and all damage is increased by 40 points. <br><font color=\"#FF7F00\">A little Spark Makes A Large Fire</font><br>Spirit is increased by 50, and all damage is reduced by 40 points. <br><font color=\"#FF7F00\">Strength of Unity</font><br>The player increases the upper limit of HP to 3500, and damage is increased by 35%.
buf_schoolwar_zzcc_5=Strength of Unity
desc_buf_schoolwar_zzcc_5_0=<font color=\"#FF7F00\">Trick the Enemy</font><br>Increase Brawn by 50, and recover 50 HP every 5 seconds. <br><font color=\"#FF7F00\">Getting a new lease on life</font><br>balance is increased by 50, and 10 Internal Energy is recovered each 5 seconds. <br><font color=\"#FF7F00\">Clear Autumn Water</font><br>Breath is increased by 50, and all damage is increased by 40 points. <br><font color=\"#FF7F00\">A little Spark Makes A Large Fire</font><br>Spirit is increased by 50, and all damage is reduced by 40 points. <br><font color=\"#FF7F00\">Overwhelming Force</font><br>Stamina is increased by 50, and rages increases 4 each 5 seconds. <br><font color=\"#FF7F00\">Strength of Unity</font><br>The player increases the upper limit of HP to 5000, and damage is increased by 50%.
