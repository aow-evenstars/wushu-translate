jn_yyzc_jx001=Bombard
desc_jn_yyzc_jx001_1=Fire projectiles to inflict damage against a group of targets.
jn_yyzc_002=Scatter
desc_jn_yyzc_002_1=Release a hail of arrows. This attack is effective against a group of densely-packed targets.
jn_yyzc_jx003=Shoot
desc_jn_yyzc_jx003_1=Order soldiers from the sentry tower to attack incoming targets.
jn_yyzc_jx004=Miracle Arrow
desc_jn_yyzc_jx004_1=Order soldiers from the sentry tower to attack incoming targets.
jn_yyzc_jx005=Throw
desc_jn_yyzc_jx005_1=Fire projectiles to inflict damage against a group of targets.
