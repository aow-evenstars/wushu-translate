desc_jn_yyzc_boss004_1=Advancing attack.
jn_yyzc_boss005=Secrets of the Brave Ones - The Destroyer
desc_jn_yyzc_boss005_1=Advancing attack.
jn_yyzc_boss006=Secrets of the Brave Ones - The Vanguisher
desc_jn_yyzc_boss006_1=Attack nearby targets.
jn_yyzc_boss007=Attack of the Wolf God
desc_jn_yyzc_boss007_1=A brutal attack.
jn_yyzc_boss008=Hunt of the Wolf God
desc_jn_yyzc_boss008_1=A brutal attack inspired by the Wolf God.
jn_yyzc_boss010=Dance of the Wolf God
desc_jn_yyzc_boss010_1=A focused attack inspired by the Wolf God.
jn_yyzc_boss050=Secrets of the Brave Ones - The Monarch
jn_yyzc_boss051=Secrets of the Brave Ones - The Warrior
desc_jn_yyzc_boss051_1=Attack nearby enemies on the ground.
jn_yyzc_boss052=Secrets of the Brave Ones - The Wise
desc_jn_yyzc_boss052_1=Attack all nearby enemies.
jn_yyzc_boss053=Howl of the Wolf God
desc_jn_yyzc_boss053_1=Attack nearby enemies with a wolf's howl.
jn_yyzc_boss054=Wrath of the Wolf God
desc_jn_yyzc_boss054_1=An area-of-effect attack inspired by the Wolf God.
jn_yyzc_boss055=Curse of the Wolf God
desc_jn_yyzc_boss055_1=Inflict massive damage to nearby enemies.
