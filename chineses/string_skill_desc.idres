desc_clone011_xg_wybr_1=<s>
clone011_xg_yham=Sad Moaning of Wandering Ghosts
desc_clone011_xg_yham_1=<s>
clone011_xg_msks=Demon Arises from the Void
desc_clone011_xg_msks_1=The heart of a demon, the hands of a devil. Bring the enemy towards you, dealing {@0: 伤害包} damage.
clone011_xg_mdhx=Magical Rampage
clone011_xg_hsqj=Total Annihilation
desc_clone011_xg_hsqj_1=<s>
