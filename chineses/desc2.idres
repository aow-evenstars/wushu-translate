desc_zither_60705=<s>
desc_zither_battlefield_50501=It's made by armorsmith master Jin Zhongliang.
desc_zither_battlefield_50601=Good for the people who do not Wu, good warriors do not anger, good enemy and the enemy, and make good use of people for the next. Legend has it that it came from the hands of the weapons master.
desc_zither_battlefield_50701=<s>
desc_zither_battlefield_60601=The way of heaven is to win without fighting, respond without speaking, come without being beckoned. Said to come from the weapons master.
desc_zither_battlefield_60701=<s>
