desc_box_battle_month_001=Contains:<br><font color="#FFFF00">Initial stage: 80000 Perfused Cultivation points, 5 Battlefield Points Tokens.</font><br><font color="#FFFF00">Beautiful Land Stage: 130000 Perfused Cultivation points, 5 Battlefield Points Tokens.</font><br><font color="#FFFF00">Pirate Raid Stage: 170000 Perfused Cultivation points, 5 Battlefield Points Tokens.</font><br><font color="#FFFF00">Soul Smashed Ninefold Stage: 210000 Perfused Cultivation points, 5 Battlefield Points Tokens.</font><br><font color="#FFFF00">Before the Duel Stage: 210000 Perfused Cultivation points, 5 Battlefield Points Tokens, 1 Battle Master Certificate (6).</font><br><font color="#FFFF00">Plague of Luoyang Stage: 250000 Perfused Cultivation points, 5 Battlefield Points Tokens, 1 Battle Master Certificate (6).</font><br><font color="#FFFF00">Traces of the Evil Cult Stage: 290000 Perfused Cultivation points, 5 Battlefield Points Tokens, 1 Battle Master Certificate (7).</font>
desc_box_battle_month_002=Contains:<br><font color="#FFFF00">Initial stage: 130000 Perfused Cultivation points, 10 Battlefield Points Tokens.</font><br><font color="#FFFF00">Beautiful Land Stage: 190000 Perfused Cultivation points, 10 Battlefield Points Tokens.</font><br><font color="#FFFF00">Pirate Raid Stage: 250000 Perfused Cultivation points, 10 Battlefield Points Tokens.</font><br><font color="#FFFF00">Soul Smashed Ninefold Stage: 320000 Perfused Cultivation points, 10 Battlefield Points Tokens.</font><br><font color="#FFFF00">Before the Duel Stage: 320000 Perfused Cultivation points, 10 Battlefield Points Tokens, 1 or 2 Battle Master Certificate (6).</font><br><font color="#FFFF00">Plague of Luoyang Stage: 380000 Perfused Cultivation points, 10 Battlefield Points Tokens, 1 or 2 Battle Master Certificate (6).</font><br><font color="#FFFF00">Traces of the Evil Cult Stage: 440000 Perfused Cultivation points, 10 Battlefield Points Tokens, 1 or 2 Battle Master Certificate (7).</font>
desc_box_battle_month_003=Contains:<br><font color="#FFFF00">Initial stage: 170000 Perfused Cultivation points, 15 Battlefield Points Tokens.</font><br><font color="#FFFF00">Beautiful Land Stage: 250000 Perfused Cultivation points, 15 Battlefield Points Tokens.</font><br><font color="#FFFF00">Pirate Raid Stage: 340000 Perfused Cultivation points, 15 Battlefield Points Tokens.</font><br><font color="#FFFF00">Soul Smashed Ninefold Stage: 420000 Perfused Cultivation points, 15 Battlefield Points Tokens.</font><br><font color="#FFFF00">Before the Duel Stage: 420000 Perfused Cultivation points, 15 Battlefield Points Tokens, 1 or 3 Battle Master Certificate (6).</font><br><font color="#FFFF00">Plague of Luoyang Stage: 500000 Perfused Cultivation points, 15 Battlefield Points Tokens, 1 or 3 Battle Master Certificate (6).</font><br><font color="#FFFF00">Traces of the Evil Cult Stage: 590000 Perfused Cultivation points, 15 Battlefield Points Tokens, 1 or 3 Battle Master Certificate (7).</font>
desc_box_battle_month_004=Contains:<br><font color="#FFFF00">Initial stage: 210000 Perfused Cultivation points, 20 Battlefield Points Tokens.</font><br><font color="#FFFF00">Beautiful Land Stage: 320000 Perfused Cultivation points, 20 Battlefield Points Tokens.</font><br><font color="#FFFF00">Pirate Raid Stage: 420000 Perfused Cultivation points, 20 Battlefield Points Tokens.</font><br><font color="#FFFF00">Soul Smashed Ninefold Stage: 530000 Perfused Cultivation points, 20 Battlefield Points Tokens.</font><br><font color="#FFFF00">Before the Duel Stage: 530000 Perfused Cultivation points, 20 Battlefield Points Tokens, 2 or 4 Battle Master Certificate (6).</font><br><font color="#FFFF00">Plague of Luoyang Stage: 630000 Perfused Cultivation points, 20 Battlefield Points Tokens, 2 or 4 Battle Master Certificate (6).</font><br><font color="#FFFF00">Traces of the Evil Cult Stage: 740000 Perfused Cultivation points, 15 Battlefield Points Tokens, 2 or 4 Battle Master Certificate (7).</font>
desc_box_battle_week_001=Contains:<br><font color="#FFFF00">Initial stage: 50000 Perfused Cultivation points, 5 Battlefield Points Tokens.</font><br><font color="#FFFF00">Beautiful Land Stage: 70000 Perfused Cultivation points, 5 Battlefield Points Tokens.</font><br><font color="#FFFF00">Pirate Raid Stage: 100000 Perfused Cultivation points, 5 Battlefield Points Tokens.</font><br><font color="#FFFF00">Soul Smashed Ninefold Stage: 130000 Perfused Cultivation points, 5 Battlefield Points Tokens.</font><br><font color="#FFFF00">Before the Duel Stage: 130000 Perfused Cultivation points, 5 Battlefield Points Tokens, a chance to get 1 Battle Master Certificate (6).</font><br><font color="#FFFF00">Plague of Luoyang Stage: 150000 Perfused Cultivation points, 5 Battlefield Points Tokens, a chance to get 1 Battle Master Certificate (6).</font><br><font color="#FFFF00">Traces of the Evil Cult Stage: 180000 Perfused Cultivation points, 5 Battlefield Points Tokens, a chance to get 1 Battle Master Certificate (7).</font>
