desc_box_20170818_mjqb_xx_001_1=<font color="#FFFF00">Must have 1 Holy Fire Divine General Token. Have a chance to get one of the followings: 1 Snow Lotus Fruit, 1 Hunyuan Pill, 5 Orders of the Hero.</font>
desc_item_20170818_mwl_xx_001_1=<font color="#FFFF00">Go to Chengdu Lin Jingyu (878, 666) to exchange for titles and chi pills. Or go to Suzhou Yun Xiao (430, 798) to exchange Fragment of Heavenly Steed.</font>
