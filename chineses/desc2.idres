desc_box_guildcity_shp_fight_win_rank_2=<font color="#00ff00">Upon opening, you will receive Horse Whistle [Ultimate] (8 days) *4, Border Town Tiger Fight Scroll Gift Pack *4</font>
desc_box_guildcity_shp_fight_win_rank_3=<font color="#00ff00">Upon opening, you will receive Horse Whistle [Ultimate] (8 days) *2, Border Town Tiger Fight Scroll Gift Pack *2</font>
