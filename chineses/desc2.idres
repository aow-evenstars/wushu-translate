desc_switch_516=Graduate from Shenji Camp.
desc_switch_517=Betray from Shenji Camp.
origin_2954=Shenwu Major General
origin_2954_desc=Shenwu prestige lasts for three life times.
origin_2955=Mystery Saintess
origin_2955_desc=Xuanji divinity tells fortune of three life times.
desc_book_qinggong_2_fc=Settle one's mind to be like placid water and turn yourself into a light wind. Then, step on the ripples calmly.
desc_book_qinggong_7_fc=Move like the shadow according as you please. Move like a flying star and the rolling thunder.
desc_book_qinggong_11_fc=“Let the wind lift you upwards. Climb a ladder made of clouds.”
desc_book_qinggong_2_fc_0=Right-click to learn "Move On Water"
desc_book_qinggong_7_fc_0=Right-click to learn "Wild Goose Flying Skill"
desc_book_qinggong_11_fc_0=Right-click to learn "Step On High Ladder"
