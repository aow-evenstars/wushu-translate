clone011_ksbf_qtzk=窮途之哭
desc_clone011_ksbf_qtzk_1=向前方敵人噴吐<font color="#FFAE00">「酒霧」</font>，噴倒範圍內目標，並降低其移動速度和命中幾率。<br>（沒喝酒時無法使用該招式）
clone011_ksbf_rskb=如喪考妣
desc_clone011_ksbf_rskb_1=掄棍疾舞，熱浪灼空，對周圍敵人造成{@0:傷害包}，同時點燃敵人身上被噴吐的<font color="#FFAE00">「酒霧」</font>。
clone011_ksbf_kthd=哭天喊地
desc_clone011_ksbf_kthd_1=虛搗天地，對前方敵人造成{@0:傷害包}，破防則封其足穴，使之6秒內使用輕功時大量流失內力；<br>同時點燃目標身上的<font color="#FFAE00">「酒霧」</font>（自身醉酒層數越高，目標所受傷害越大）。
clone011_ksbf_nkyt=鳥哭猿啼
desc_clone011_ksbf_nkyt_1=衝鋒招式，連搗三擊，對目標造成{@0:傷害包}。<br>（此招式可利用輕功快速接近對手）
clone011_ksbf_shlp=喪魂落魄
desc_clone011_ksbf_shlp_1=哭喪至極，若瘋若風，顛狂抽打對目標造成{@0:傷害包}。
clone011_ksbf_ykwl=欲哭無淚
desc_clone011_ksbf_ykwl_1=揮棍破空而擊，氣勁對空中目標造成{@0:傷害包}；<br>若自己在醉酒狀態,則消耗一層<font color="#FFAE00">「醉意」</font>，使目標受到一次爆炸傷害並被擊飛。
clone011_lsbf_lsfd=龍蛇飛動
desc_clone011_lsbf_lsfd_1=衝鋒招式，靈動擺擊，對目標造成{@0:傷害包}，目標身中<font color="#FFAE00">「靈蛇奇毒」</font>時受傷更重。<br>（此招式可利用輕功快速接近對手）
clone011_lsbf_srsx=蛇入鼠穴
desc_clone011_lsbf_srsx_1=肆意橫掃，氣勁對前方敵人造成{@0:傷害包}，並擊倒身受<font color="#FFAE00">「靈蛇奇毒」</font>折磨的目標。
clone011_lsbf_skfz=蛇口蜂針
desc_clone011_lsbf_skfz_1=力凝一點，尋破而擊，對前方敵人造成{@0:傷害包}；<br>敵若妄圖招架則將其擊倒，並使其感染傷害更猛的<font color="#FFAE00">「靈蛇劇毒」</font>。
clone011_lsbf_fscs=封豕長蛇
desc_clone011_lsbf_fscs_1=靈蛇遊走，形跡莫測，幻化連擊對目標造成{@0:傷害包}；目標身中<font color="#FFAE00">「靈蛇奇毒」</font>時受傷更重
clone011_lsbf_spqz=蛇磐青竹
desc_clone011_lsbf_spqz_1=橫掃斜刺，對前方敵人造成{@0:傷害包}；目標身中<font color="#FFAE00">「靈蛇奇毒」</font>時受傷更重。
clone011_lsbf_sxsc=蛇形鼠竄
